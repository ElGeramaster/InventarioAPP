<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Indicador de urgencia (barra de color a la izquierda) -->
        <View
            android:id="@+id/viewIndicadorCaducidad"
            android:layout_width="6dp"
            android:layout_height="0dp"
            android:background="#E53935"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Thumbnail del producto -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardThumbnailCaducidad"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:visibility="gone"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/viewIndicadorCaducidad">

            <ImageView
                android:id="@+id/ivThumbnailCaducidad"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Imagen del producto"/>

        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvNombreCaducidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Nombre producto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#212121"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardThumbnailCaducidad"
            app:layout_constraintEnd_toStartOf="@id/tvEstadoCaducidad"/>

        <TextView
            android:id="@+id/tvCategoriaCaducidad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Categoría"
            android:textSize="13sp"
            android:textColor="#757575"
            app:layout_constraintTop_toBottomOf="@id/tvNombreCaducidad"
            app:layout_constraintStart_toEndOf="@id/cardThumbnailCaducidad"
            app:layout_constraintEnd_toStartOf="@id/tvEstadoCaducidad"/>

        <TextView
            android:id="@+id/tvFechaCaducidadItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="00/00/0000"
            android:textSize="13sp"
            android:textColor="#9E9E9E"
            app:layout_constraintTop_toBottomOf="@id/tvCategoriaCaducidad"
            app:layout_constraintStart_toEndOf="@id/cardThumbnailCaducidad"
            app:layout_constraintEnd_toStartOf="@id/tvEstadoCaducidad"/>

        <TextView
            android:id="@+id/tvEstadoCaducidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vencido"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>